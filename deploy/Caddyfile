ocr.mocban.org {
    # Preserve /api when proxying: every FastAPI endpoint uses this prefix.
    handle /api/* {
        reverse_proxy localhost:8000
    }

    handle {
        root * /var/www/ocr-web
        try_files {path} /index.html
        file_server
    }

    request_body {
        max_size 100MB
    }
}
